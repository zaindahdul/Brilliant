# Copy this file to .env.local, paste your Anthropic key, then restart `npm run dev`.
# Get a key from the Claude Developer Platform console: https://platform.claude.com → API keys.
# .env.local is gitignored — never commit a key.
ANTHROPIC_API_KEY=

# Optional: a different Claude model. Default is claude-opus-5-5.
# claude-sonnet-5-5 is faster and cheaper; claude-haiku-5-5 is the lightest.
# AI_MODEL=claude-opus-5-5

# Optional: how hard the tutor thinks before replying — low | medium | high | xhigh | max (default medium).
# AI_EFFORT=medium
