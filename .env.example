# Copy this file to .env.local, paste your Gemini key, then restart `npm run dev`.
# Get a key at https://aistudio.google.com/apikey — the free tier covers the Flash models.
GEMINI_API_KEY=

# Optional: a different Gemini model. Default is gemini-3.8-flash (stable, free tier).
# gemini-3.5-flash-lite is lighter and faster if you hit rate limits.
# AI_MODEL=gemini-3.8-flash

# Optional: how hard the tutor thinks before replying — minimal | low | medium | high (default medium).
# AI_THINKING_LEVEL=medium
